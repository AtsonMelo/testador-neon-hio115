    { "signalId": "PermissivoAgua", "signalLabel": "Permissivo de água", "direction": "input", "ioType": "digital", "channel": 5, "register": 31125, "registerAlias": "DI05", "description": "Permissivo de água simulado", "evidenceStatus": "simulationProfile" },
