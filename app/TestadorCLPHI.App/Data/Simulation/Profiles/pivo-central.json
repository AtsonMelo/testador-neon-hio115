    { "signalId": "Pressostato", "signalLabel": "Pressostato", "direction": "input", "ioType": "digital", "channel": 1, "register": 31121, "registerAlias": "DI01", "description": "Pressostato do processo simulado", "evidenceStatus": "simulationProfile" },
    { "signalId": "Alinhamento", "signalLabel": "Alinhamento", "direction": "input", "ioType": "digital", "channel": 2, "register": 31122, "registerAlias": "DI02", "description": "Condição de alinhamento simulada", "evidenceStatus": "simulationProfile" },
    { "signalId": "FimDeCurso", "signalLabel": "Fim de curso", "direction": "input", "ioType": "digital", "channel": 3, "register": 31123, "registerAlias": "DI03", "description": "Fim de curso do processo simulado", "evidenceStatus": "simulationProfile" },
