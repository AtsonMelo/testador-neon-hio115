    { "signalId": "Corrente", "signalLabel": "Corrente", "direction": "input", "ioType": "analog", "channel": 1, "register": 31133, "registerAlias": "AI01", "description": "Corrente raw do perfil", "evidenceStatus": "simulationProfile" },
    { "signalId": "PosicaoPercentual", "signalLabel": "Posição", "direction": "input", "ioType": "analog", "channel": 2, "register": 31134, "registerAlias": "AI02", "description": "Posição percentual simulada", "evidenceStatus": "simulationProfile" },
    { "signalId": "Bomba", "signalLabel": "Bomba", "direction": "output", "ioType": "digital", "channel": 0, "register": 31128, "registerAlias": "DO00", "description": "Comando virtual da bomba", "evidenceStatus": "simulationProfile" },
    { "signalId": "Frente", "signalLabel": "Frente", "direction": "output", "ioType": "digital", "channel": 1, "register": 31129, "registerAlias": "DO01", "description": "Comando virtual de avanço", "evidenceStatus": "simulationProfile" },
    { "signalId": "Reverso", "signalLabel": "Reverso", "direction": "output", "ioType": "digital", "channel": 2, "register": 31130, "registerAlias": "DO02", "description": "Comando virtual de reversão", "evidenceStatus": "simulationProfile" },
    { "signalId": "ValvulaAgua", "signalLabel": "Válvula de água", "direction": "output", "ioType": "digital", "channel": 3, "register": 31131, "registerAlias": "DO03", "description": "Comando virtual da válvula", "evidenceStatus": "simulationProfile" }
  ],
  "rules": [
    { "id": "emergency", "priority": 100, "conditions": [{ "signalId": "Emergencia", "comparison": "equals", "expectedValue": 1 }], "resultState": "Emergencia", "alarmId": "Emergency", "blockAllOutputs": true },
    { "id": "tower-fault", "priority": 90, "conditions": [{ "signalId": "FalhaTorre", "comparison": "equals", "expectedValue": 1 }], "resultState": "Falha", "alarmId": "TowerFault", "blockAllOutputs": true },
    { "id": "misaligned", "priority": 80, "conditions": [{ "signalId": "Alinhamento", "comparison": "equals", "expectedValue": 0 }], "resultState": "Desalinhado", "alarmId": "AlignmentFault", "blockAllOutputs": true },
    { "id": "end-of-travel", "priority": 75, "conditions": [{ "signalId": "FimDeCurso", "comparison": "equals", "expectedValue": 1 }], "resultState": "FimDeCurso", "alarmId": "EndOfTravel", "blockAllOutputs": true },
    { "id": "pressure-low", "priority": 70, "conditions": [{ "signalId": "Bomba", "comparison": "equals", "expectedValue": 1 }, { "signalId": "Pressao", "comparison": "lessThan", "expectedValue": 2 }], "resultState": "Falha", "alarmId": "PressureLow", "blockAllOutputs": true },
    { "id": "moving-forward", "priority": 40, "conditions": [{ "signalId": "Frente", "comparison": "equals", "expectedValue": 1 }], "resultState": "MovendoFrente", "alarmId": "", "blockAllOutputs": false },
    { "id": "moving-reverse", "priority": 40, "conditions": [{ "signalId": "Reverso", "comparison": "equals", "expectedValue": 1 }], "resultState": "MovendoReverso", "alarmId": "", "blockAllOutputs": false },
    { "id": "irrigating", "priority": 30, "conditions": [{ "signalId": "Bomba", "comparison": "equals", "expectedValue": 1 }, { "signalId": "ValvulaAgua", "comparison": "equals", "expectedValue": 1 }], "resultState": "Irrigando", "alarmId": "", "blockAllOutputs": false },
    { "id": "preparing", "priority": 20, "conditions": [{ "signalId": "Bomba", "comparison": "equals", "expectedValue": 1 }], "resultState": "Preparando", "alarmId": "", "blockAllOutputs": false }
  ],
  "exclusiveOutputGroups": [
    { "id": "movement-direction", "signalIds": ["Frente", "Reverso"] }
  ],
  "scenarios": [
    { "id": "normal", "displayName": "Normal", "values": {} },
    { "id": "irrigando", "displayName": "Irrigando", "values": { "Bomba": 1, "ValvulaAgua": 1 } },
