    { "signalId": "Valvula", "signalLabel": "Válvula", "direction": "output", "ioType": "digital", "channel": 1, "register": 31129, "registerAlias": "DO01", "description": "Comando virtual da válvula", "evidenceStatus": "simulationProfile" }
