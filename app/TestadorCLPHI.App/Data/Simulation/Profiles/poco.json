    { "signalId": "Pressao", "signalLabel": "Pressão", "direction": "input", "ioType": "analog", "channel": 1, "register": 31133, "registerAlias": "AI01", "description": "Pressão raw do perfil", "evidenceStatus": "simulationProfile" },
    { "signalId": "Corrente", "signalLabel": "Corrente", "direction": "input", "ioType": "analog", "channel": 2, "register": 31134, "registerAlias": "AI02", "description": "Corrente raw do perfil", "evidenceStatus": "simulationProfile" },
