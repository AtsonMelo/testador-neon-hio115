    { "signalId": "SensorInvalido", "signalLabel": "Sensor inválido", "direction": "input", "ioType": "digital", "channel": 5, "register": 31125, "registerAlias": "DI05", "description": "Sensor inválido simulado", "evidenceStatus": "simulationProfile" },
